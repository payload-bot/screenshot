{
  "tasks": {
    "dev": "OTEL_DENO=true OTEL_SERVICE_NAME=screenshot_dev deno --unstable-otel -A --watch main.ts",
    "prod": "OTEL_DENO=true OTEL_SERVICE_NAME=screenshot deno --unstable-otel -N main.ts",
    "test": "deno test -A"
  },
  "imports": {
    "arktype": "npm:arktype@^2.1.10",
    "astral": "jsr:@astral/astral"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true
  }
}
