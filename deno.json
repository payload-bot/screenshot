{
  "tasks": {
    "dev": "OTEL_DENO=true OTEL_SERVICE_NAME=screenshot_dev deno --unstable-otel -A --watch --env-file=.env main.ts",
    "prod": "deno --unstable-otel --allow-run -NWRE main.ts",
    "test": "deno test -A"
  },
  "imports": {
    "arktype": "npm:arktype@^2.1.15",
    "astral": "jsr:@astral/astral@^0.5.2"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true
  }
}
