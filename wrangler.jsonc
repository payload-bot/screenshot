/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payload-screenshot",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat", "new_module_registry"],
  "previews": {
    "browser": {
      "binding": "BROWSER",
    },
  },
  "vars": {
    "NODE_ENV": "production",
  },
  "workers_dev": false,
  "observability": {
    "enabled": false,
  },
  "upload_source_maps": true,
  "browser": {
    "binding": "BROWSER",
  },
  "cache": {
    "cross_version_cache": true,
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css"],
      "fallthrough": true,
    },
  ],
  "routes": [
    {
      "pattern": "screenshot.payload.tf",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
    {
      "pattern": "screenshot-dev.payload.tf",
      "custom_domain": true,
      "enabled": false,
      "previews_enabled": true,
    },
  ],
}
